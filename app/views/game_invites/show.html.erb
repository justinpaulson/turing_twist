<% content_for(:title, "Join Game ##{@game.id} - Turing Twist") %>

<style>
  .invite-container {
    max-width: 680px;
    margin: 0 auto;
    font-family: 'Courier New', monospace;
  }

  .invite-masthead {
    border: 4px solid #000;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 8px 8px 0 #000;
  }

  .invite-masthead h1 {
    font-size: clamp(2rem, 9vw, 3.5rem);
    margin: 0;
  }

  .invite-game-number {
    background: #000;
    color: #fff;
    font-size: clamp(2.5rem, 14vw, 5rem);
    font-weight: 900;
    line-height: 1;
    margin: 2rem 0 1.5rem;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .invite-actions {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .invite-actions .btn {
    text-align: center;
  }

  .invite-primary {
    background: #000;
    color: #fff;
  }
</style>

<section class="invite-container">
  <div class="invite-masthead">
    <p><strong>YOU'VE BEEN INVITED TO</strong></p>
    <h1>TURING TWIST</h1>
    <p>THE AI DECEPTION GAME</p>
  </div>

  <div class="invite-game-number">GAME #<%= @game.id %></div>

  <div class="box">
    <div class="box-header">► Open the invitation</div>
    <p>This link opens the Turing Twist app automatically when it is installed.</p>
    <p class="mt-2">The iPhone and iPad app is not on the App Store yet, but you can join this game in your browser now.</p>

    <div class="invite-actions">
      <%= link_to "► CONTINUE ON THE WEB", game_path(@game), class: "btn invite-primary" %>
      <%= link_to "WHAT IS TURING TWIST?", root_path, class: "btn" %>
    </div>
  </div>
</section>
